name: "fraud_detection"
platform: "onnxruntime_onnx"
max_batch_size: 128

input [
  {
    name: "transaction_features"
    data_type: TYPE_FP32
    dims: [ 30 ]
  }
]

output [
  {
    name: "fraud_probability"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 8, 16, 32, 64, 128 ]
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
